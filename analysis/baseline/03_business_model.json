  "formulas": {
    "Q_scenario_segment": "N_s * (Q0_s/N_s + dq_s)",
    "A_scenario_segment": "Q_scenario_s * (A0_s/Q0_s + dp_s)",
    "incremental_activation": "A_scenario_s-A0_s; core lift only; noncore flat",
    "marginal_cost": "sum(max(DeltaA_s,0) * historical_mean_activated_acquisition_cost_s)",
    "recurring_cost": "C0 + marginal_cost + 50*3956; zero assumed avoidable historical spend",
    "CAC": "recurring_cost / sum(A_scenario_s)",
    "incremental_MRR": "sum(DeltaA_s * ARPU_no_detected_rule_conflict_s)",
    "conditional_total_MRR": "historical_MRR + incremental_MRR; retained-value assumption, enforcement stress separate",
    "gross_revenue_payback": "recurring_cost / conditional_total_MRR; no profit/margin claim",
    "annualized_run_rate": "12*incremental_MRR; steady run-rate sensitivity, not realized pilot revenue, recognized ARR or retained cash",
    "CAC_headroom": "A_scenario*historical_CAC - recurring_cost; not cash savings",
    "churn_target": "sum(A_scenario_s * max(0,recorded_churn_rate_s - core_churn_reduction_pp_s/100)) / totalA",
    "followup_target": "sum(A_scenario_s * max(0,observed_calls_s - core_call_reduction_s)) / totalA",
    "enforcement_stress": "subtract56 activations and INR768830 recorded MRR from scenario; retain full recurring cost; not estimated recurrence"
  }
